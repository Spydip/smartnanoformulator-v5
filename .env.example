# Shared login for a hosted demonstration. Keep password private.
APP_ACCESS_USER=mates
APP_ACCESS_PASSWORD=

# Local database and host defaults. Render supplies PORT and overrides the DB path.
SMARTNANO_DB=smartnano.db
SMARTNANO_HOST=127.0.0.1

# Free cloud AI via OpenRouter. Keep the key on the server only; never place it in browser code.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ENABLED=1
LLM_DAILY_REQUEST_LIMIT=12
LLM_MONTHLY_SPEND_USD=0.00
LLM_REQUEST_TIMEOUT_SECONDS=45
